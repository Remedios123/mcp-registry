# Copy to <instance>/gateway.env and restrict access to the account running the gateway.
# Existing process environment variables override this file.

WINDOWS_MANAGE_KEYCLOAK=true
WINDOWS_MANAGE_MONGO=true
WINDOWS_MANAGE_CAS_SHIM=false
# Initial account signup policy for a new CAS broker in locally managed Keycloak.
# WINDOWS_CAS_SIGNUP_MODE=whitelist
WINDOWS_MANAGE_MCPGW=true

WINDOWS_GATEWAY_PORT=17860
WINDOWS_INTERNAL_PORT=18091
WINDOWS_REGISTRY_PORT=7860
WINDOWS_AUTH_PORT=18888
WINDOWS_KEYCLOAK_PORT=18080
WINDOWS_KEYCLOAK_MANAGEMENT_PORT=19000
WINDOWS_MONGO_PORT=27037
WINDOWS_SHIM_PORT=8085
WINDOWS_MCPGW_PORT=8003
# REGISTRY_WINDOWS_MCPGW_PYTHON=D:/Project/mcp-registry-runtime/mcpgw-venv/Scripts/python.exe

# Default REGISTRY_URL follows WINDOWS_GATEWAY_PORT. Set it explicitly behind TLS.
# REGISTRY_URL=https://gateway.company.example
AUTH_PROVIDER=keycloak
# Keys and passwords are supplied by the operator.
SECRET_KEY=
AUTH_SERVER_NGINX_MARKER_SECRET=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_CLIENT_SECRET=
DOCUMENTDB_DATABASE=mcp_registry

# Loopback endpoints for native processes. Enable narrowly scoped exceptions
# if an adapter uses loopback addresses. Omit this for remote HTTPS adapters.
NO_PROXY=127.0.0.1,localhost
# SSRF_ALLOWED_CIDRS=127.0.0.1/32

# For an existing authenticated MongoDB, set WINDOWS_MANAGE_MONGO=false above.
# Real company CAS and UC use authenticated connections for both databases.
# MONGODB_CONNECTION_STRING=mongodb://USER:PASSWORD@mongo.company.example:27017/mcp_registry?authSource=admin&tls=true
# SHIM_MONGO_URI=mongodb://SHIM_USER:PASSWORD@mongo.company.example:27017/cas_shim?authSource=admin&tls=true
# SHIM_MONGO_DB=cas_shim
# SHIM_MONGO_COLLECTION=business_tokens

# Company CAS and UC. Enable WINDOWS_MANAGE_CAS_SHIM above and fill the settings here.
# CAS_SHIM_MOCK=false
# CAS_BASE=https://cas.company.example/cas
# UC_AUTH_URL=https://uc.company.example/uc/sso/auth
# UC_REFRESH_URL=https://uc.company.example/uc/refresh
# UC_REFRESH_METHOD=get
# CAS_TLS_VERIFY=true
# CAS_CA_BUNDLE=D:/Project/certs/company-ca.pem
# SHIM_CLIENT_ID=mcp-gateway-keycloak
# SHIM_CLIENT_SECRET=
# SHIM_SIGNING_SECRET=
# SHIM_INTERNAL_TOKEN=

# The launcher derives the loopback shim URLs for browsers on this machine.
# For browsers accessing the server over HTTPS, configure the reverse proxy and these URLs.
# SHIM_BASE_URL=http://127.0.0.1:8085
# SHIM_PUBLIC_URL=https://cas-shim.company.example
# SHIM_CALLBACK_URL=https://cas-shim.company.example/cas/callback
# SHIM_ALLOWED_REDIRECT_URIS=https://sso.company.example/realms/mcp-gateway/broker/cas/endpoint

# For a browser-facing Keycloak, set WINDOWS_MANAGE_KEYCLOAK=false above and run Keycloak separately.
# Set REGISTRY_URL above to the gateway's browser-facing HTTPS origin.
# KEYCLOAK_URL=http://127.0.0.1:18080
# KEYCLOAK_ADMIN_URL=http://127.0.0.1:18080
# KEYCLOAK_EXTERNAL_URL=https://sso.company.example
# KEYCLOAK_REALM=mcp-gateway
# KEYCLOAK_CLIENT_ID=mcp-gateway-web
# SESSION_COOKIE_SECURE=true

# Optional UC credential injection for registered MCP services. Match each upstream URL exactly.
# EGRESS_AUTH_ENABLED=true
# ENTERPRISE_CREDENTIAL_PROFILES=[{"id":"uc","label":"UC","issuer":"uc","upstreams":["http://127.0.0.1:8000/mcp"]}]
