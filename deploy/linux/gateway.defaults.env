# Compose interpolation defaults for the HTTPS instance. Instance env is loaded last.
REGISTRY_URL=https://mcpgateway.geehy.com
GATEWAY_ADDITIONAL_SERVER_NAMES=mcpgateway.geehy.com
AUTH_SERVER_URL=http://auth-server:8888
KEYCLOAK_ENABLED=true
AUTH_PROVIDER=keycloak
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=mcp-gateway
KEYCLOAK_ADMIN=admin
KEYCLOAK_CLIENT_ID=mcp-gateway-web
KEYCLOAK_M2M_CLIENT_ID=mcp-gateway-m2m
MCP_OAUTH_AS_ON_GATEWAY_REALM=true
MCP_HTTPS_REQUIRED=true
SESSION_COOKIE_SECURE=true
DOCUMENTDB_USERNAME=mcp_bootstrap
DOCUMENTDB_DATABASE=mcp_registry
STORAGE_BACKEND=mongodb-ce
EGRESS_AUTH_ENABLED=true
ENTERPRISE_CREDENTIAL_SHIM_URL=http://127.0.0.1:8093
ENTERPRISE_CREDENTIAL_SHIM_PUBLIC_URL=https://mcpgateway.geehy.com
ENTERPRISE_CREDENTIAL_PROFILES='[{"id":"uc","label":"UC","issuer":"uc"}]'
CAS_SHIM_MOCK=false
CAS_BASE=https://cas.geehy.com:8090/cas
UC_AUTH_URL=https://ecp.apexmicgroup.com:5577/uc/sso/auth
UC_REFRESH_URL=https://ecp.apexmicgroup.com:5577/uc/refresh
UC_REFRESH_METHOD=get
CAS_TLS_VERIFY=true
SHIM_CLIENT_ID=mcp-gateway-keycloak
SHIM_BASE_URL=http://cas-shim:8085
SHIM_MONGO_DB=cas_shim
SHIM_MONGO_COLLECTION=business_tokens
BUSINESS_TOKEN_IDLE_LIMIT_HOURS=72
REFRESH_MARGIN_HOURS=12
REFRESH_BATCH_CRON=03:00,15:00
REFRESH_BATCH_RATE_PER_MINUTE=100
EMBEDDINGS_PROVIDER=sentence-transformers
EMBEDDINGS_MODEL_NAME=bge-small-zh-v1.5
EMBEDDINGS_MODEL_DIMENSIONS=512
TOOL_REFRESH_ENABLED=false
TZ=Asia/Shanghai
NO_PROXY=localhost,127.0.0.1,10.100.3.74,mcpgateway.geehy.com,registry,auth-server,mcpgw-server,keycloak,keycloak-db,mongodb,cas-shim,openbao,metrics-service
