# CAS-Shim 配置样例(复制为 .env 后按需修改)
# ── CAS 侧(公司 UAT 已实测值,勿改 host) ──
CAS_BASE=https://cas.example.test/cas
UC_AUTH_URL=https://uc.example.test/uc/sso/auth
# UAT 证书自签;true 仅在给 CAS 服务器装了可信证书后使用
CAS_TLS_VERIFY=true
# Set only while migrating trusted plaintext rows from the old vault.
SHIM_ALLOW_LEGACY_VAULT=false

# ── Shim 自身 ──
SHIM_BASE_URL=http://localhost:8085
SHIM_CALLBACK_URL=http://localhost:8085/cas/callback
# Keycloak 作为 RP 调用本 IdP 时使用的客户端凭证(在 Keycloak 联邦配置里填同一套)
SHIM_CLIENT_ID=mcp-gateway-keycloak
SHIM_CLIENT_SECRET=生成一个随机值,与 Keycloak 联邦配置一致
# cookie 防篡改签名密钥(必填,随机 32+ 字节)
SHIM_SIGNING_SECRET=生成一个随机值
# vault 内部接口凭据(后续网关 egress broker 取业务令牌用)
SHIM_INTERNAL_TOKEN=生成一个随机值

# ── vault 存储(Mongo) ──
# 业务令牌缓存迁入 Mongo 后的连接配置;默认值如下,通常无需修改。
# 独立库名 cas_shim: 与 registry 的 mcp_registry 库分开, 备份同实例一起做。
SHIM_MONGO_URI=mongodb://127.0.0.1:27017
SHIM_MONGO_DB=cas_shim
SHIM_MONGO_COLLECTION=business_tokens

# ── 模式开关 ──
# true: 不调真实 CAS/UC,用模拟用户跑通 OIDC 全流程(联调用)
CAS_SHIM_MOCK=false

# ── 业务令牌滑动续期(2026-11-09, 设计与规格见 FORK-NOTES §一 E) ──
# 静默超过该小时数的账号: 令牌不再服务也不再后台续期, 须重新登录(硬闸)。
BUSINESS_TOKEN_IDLE_LIMIT_HOURS=72
# UC 刷新接口(旧 token 放 Authorization 头换新 24h token); 留空 = 功能整体关闭。
UC_REFRESH_URL=https://uc.example.test/uc/refresh
# 刷新请求的 HTTP 方法(2026-11-09 用户确认为 GET)
UC_REFRESH_METHOD=get
# 每 12h 的两个批量续期时刻(24h 制, 逗号分隔)
REFRESH_BATCH_CRON=03:00,15:00
# 批量内每分钟最多发出的刷新请求数(防瞬时冲击 UC)
REFRESH_BATCH_RATE_PER_MINUTE=100
# 令牌剩余寿命低于该小时数时, 读取与批量才会触发续期
REFRESH_MARGIN_HOURS=12

# breakout 页 iframe 那条回调的挂住上限(秒; 浏览器跳走即提前结束)
IFRAME_HOLD_SECONDS=30

# Public browser origin used in worktool authorization links.
SHIM_PUBLIC_URL=http://127.0.0.1:8085

# Exact Keycloak redirect URI as seen in the browser.
SHIM_ALLOWED_REDIRECT_URIS=http://127.0.0.1:18080/realms/mcp-gateway/broker/cas/endpoint
# CAS_CA_BUNDLE=/path/to/organization-ca.pem
